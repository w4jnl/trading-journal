<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- make ios-testflight: export the archive for App Store Connect and upload it (TestFlight).
     Signing is automatic with the team in Local.xcconfig; Xcode raises the build number when
     App Store Connect already has this one. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
	<key>testFlightInternalTestingOnly</key>
	<false/>
</dict>
</plist>
