// Copy to Local.xcconfig (gitignored; make ios-project writes a default one). Your Apple team
// id signs device and TestFlight builds (the simulator needs none): Xcode → Settings → Accounts,
// or Membership in the developer account.
TJ_TEAM_ID = ABCDE12345
// Which entitlements to sign with.
//   TradingJournal/TradingJournal.entitlements        push, time-sensitive alerts, the App Group and the
//                                                      keychain group: needs the App Group and "Time
//                                                      Sensitive Notifications" registered on the App ID in
//                                                      the developer portal once (README: On a phone).
//   TradingJournal/TradingJournal.basic.entitlements  push and the keychain group only: what xcodebuild can
//                                                      register by itself with the API key below; no
//                                                      widgets, no time-sensitive break-through.
//   (empty)                                           a free Apple ID's personal team: works while open.
TJ_ENTITLEMENTS = TradingJournal/TradingJournal.entitlements
// Optional: an App Store Connect API key (Users and Access → Integrations → App Store Connect
// API, role Admin), so make ios-testflight and ios-device sign in with it instead of Xcode's
// account, whose session expires. The .p8 goes to ~/.appstoreconnect/private_keys/AuthKey_<key id>.p8
// (chmod 600); empty: Xcode's account.
TJ_ASC_KEY_ID =
TJ_ASC_ISSUER_ID =
