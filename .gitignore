# Import workflow — never commit user trade data or processed/failed files
/imports/inbox/*
/imports/processed/*
/imports/failed/*
/imports/uploads/*
!/imports/inbox/.gitkeep
!/imports/processed/.gitkeep
!/imports/failed/.gitkeep

# Backup archives — local snapshots of db + authored files.
/backups/

# OI dashboards — runtime data populated by an external pipeline.
# The folder itself stays out of git; bind-mounted into the container.
/oi_dashboard/

